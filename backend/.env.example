# ========================================================
# FLIGHT TICKET MANAGEMENT - BACKEND ENVIRONMENT VARIABLES (.env.example)
# Sao chép file này thành .env và điền các giá trị phù hợp với máy của bạn.
# ========================================================

# --------------------------------------------------------
# 1. Cổng máy chủ Backend
# --------------------------------------------------------
SERVER_PORT=5000

# --------------------------------------------------------
# 2. Cấu hình cơ sở dữ liệu MySQL
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flight_ticket_management
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_URL=jdbc:mysql://localhost:3306/flight_ticket_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8

# --------------------------------------------------------
# 3. Cấu hình JPA / Hibernate
# --------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --------------------------------------------------------
# 4. Cấu hình bảo mật JWT
# --------------------------------------------------------
JWT_SECRET=EasyFlightSecretKeyForJWTAuthentication2026ModernDesignProMaxUltra
JWT_EXPIRATION=86400000

# --------------------------------------------------------
# 5. Cấu hình gửi Mail qua SMTP (Google Mail)
# --------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

# --------------------------------------------------------
# 6. Môi trường Spring Profile
# --------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

